# Server
PORT=3001
NODE_ENV=development
HOST=127.0.0.1

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173

# Required: generate a unique random secret of at least 32 characters.
JWT_SECRET=
# Required only for the first account; remove after the administrator is registered.
ADMIN_BOOTSTRAP_TOKEN=

# Gatus monitoring engine
GATUS_URL=http://localhost:8080
GATUS_CONFIG_PATH=../monitoring/config/config.yaml
GATUS_DYNAMIC_CONFIG_ENABLED=false

# SQLite database path
DB_PATH=./data/stackpulse.db

# Simulated notification recipients only; no external delivery is performed.
SIMULATED_NOTIFICATION_EMAIL=simulated-email
SIMULATED_WEBHOOK_LABEL=simulated-webhook

# Optional, operator-authorized destination for manual failure verification.
# Uses the same URL/DNS/IP restrictions as monitored endpoints; never use an arbitrary third-party URL.
TRUSTPULSE_REFERENCE_URL=

# Optional AI incident explanations. Leave unset to use deterministic IncidentLens only.
# Configure the exact local OpenAI-compatible chat-completions URL and a model verified as free in OmniRoute.
OMNIROUTE_CHAT_COMPLETIONS_URL=
OMNIROUTE_MODEL=
OMNIROUTE_API_KEY=
OMNIROUTE_FREE_MODEL_CONFIRMED=false
OMNIROUTE_TIMEOUT_MS=5000

